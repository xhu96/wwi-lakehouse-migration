/// One row per booking, including upcoming ones (status confirmed). Amounts are in EUR, VAT included.
table Bookings
	lineageTag: c9235df4-2fc8-5991-8fc9-ca8079b1db88

	column 'Booking ID'
		dataType: int64
		formatString: 0
		lineageTag: 739956ff-5173-5a27-9e1f-1e96f3547599
		summarizeBy: none
		sourceColumn: booking_id

	column 'Service Date'
		dataType: dateTime
		isHidden
		formatString: dd mmm yyyy
		lineageTag: 50113da5-5fc4-53d4-a8bf-90cae238d810
		summarizeBy: none
		sourceColumn: service_date

		annotation UnderlyingDateTimeDataType = Date

	/// Start time in Rome local time.
	column 'Scheduled Start'
		dataType: dateTime
		formatString: dd mmm yyyy hh:nn
		lineageTag: ab1e2261-6b31-56b2-ab1e-c84bb0d0372b
